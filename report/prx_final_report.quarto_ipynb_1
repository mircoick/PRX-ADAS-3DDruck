   "source": [
    "#| label: fig-pt100_pt1000\n",
    "#| fig-cap: Kennlinie der Pt100 und Pt1000 Sensoren\n",
    "#| echo: false\n",
    "#| warning: false\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "A = 3.9083e-3\n",
    "B = -5.775e-7\n",
    "C = -4.183e-12\n",
    "\n",
    "temp = np.linspace(-200, 850, 1000)\n",
    "\n",
    "def pt_resistance(r0, t_arr):\n",
    "    r = np.zeros_like(t_arr)\n",
    "    for i, t in enumerate(t_arr):\n",
    "        if t >= 0:\n",
    "            r[i] = r0 * (1 + A * t + B * t**2)\n",
    "        else:\n",
    "            r[i] = r0 * (1 + A * t + B * t**2 + C * (t - 100) * t**3)\n",
    "    return r\n",
    "\n",
    "r_pt100 = pt_resistance(100, temp)\n",
    "r_pt1000 = pt_resistance(1000, temp)\n",
    "\n",
    "fig = plt.figure()\n",
    "fig.set_size_inches(5, 3.5)\n",
    "\n",
    "plt.plot(temp, r_pt1000, label='Pt1000', color='#d62728', lw=2)\n",
    "plt.plot(temp, r_pt100, label='Pt100', color='#2ca02c', lw=2)\n",
    "\n",
    "plt.title('Pt100 & Pt1000 Kennlinie', fontsize=13, weight='bold', pad=12)\n",
    "plt.xlabel('Temperatur in °C', fontsize=11)\n",
    "plt.ylabel('Widerstand in Ω', fontsize=11)\n",
    "plt.xlim(-200, 850)\n",
    "plt.ylim(0, 4000)\n",
    "plt.grid(True, which='both', linestyle='--', alpha=0.5)\n",
    "plt.legend(fontsize=11, loc='center right', frameon=True)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
